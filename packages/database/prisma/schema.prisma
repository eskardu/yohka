generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  ON_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  STC_PAY
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model StoreSettings {
  id            String   @id @default("default")
  deliveryTitle String   @default("Ближайшие дни доставки")
  deliveryDays  String[] @default(["Вторник", "Четверг", "Суббота"])
  headerImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String?
  categoryId    String
  badge         String?
  purchasePrice Decimal     @db.Decimal(12, 2)
  salePrice     Decimal     @db.Decimal(12, 2)
  discountPrice Decimal?    @db.Decimal(12, 2)
  unit          String
  stockQuantity Decimal     @default(0) @db.Decimal(12, 3)
  imageUrl      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]

  @@index([categoryId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(autoincrement())
  userId          String
  status          OrderStatus   @default(NEW)
  totalAmount     Decimal       @db.Decimal(12, 2)
  profitAmount    Decimal       @db.Decimal(12, 2)
  deliveryFee     Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  customerName    String
  customerPhone   String
  latitude        Decimal       @db.Decimal(10, 7)
  longitude       Decimal       @db.Decimal(10, 7)
  addressText     String?
  customerComment String?
  deliveryDay     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id                    String  @id @default(cuid())
  orderId               String
  productId             String
  productNameSnapshot   String
  purchasePriceSnapshot Decimal @db.Decimal(12, 2)
  salePriceSnapshot     Decimal @db.Decimal(12, 2)
  quantity              Decimal @db.Decimal(12, 3)
  totalPrice            Decimal @db.Decimal(12, 2)
  profit                Decimal @db.Decimal(12, 2)
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
